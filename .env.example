# Copy to .env and change the password and NAS host path before starting Compose.
POSTGRES_USER=dendroflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# The mounted lab files appear at DENDROFLOW_NAS_CONTAINER_PATH inside CLI containers.
DENDROFLOW_NAS_HOST_PATH=/path/to/mounted/files
DENDROFLOW_NAS_CONTAINER_PATH=/files

# Docker-managed snapshots are removed together with PostgreSQL by compose down --volumes.
DENDROFLOW_SNAPSHOT_VOLUME_NAME=dendroflow_lab_snapshots
DENDROFLOW_SNAPSHOT_CONTAINER_PATH=/snapshots
DENDROFLOW_FILE_SETTLE_SECONDS=1

# Only for commands run in a host .venv; Compose sets its own snapshot path.
DENDROFLOW_SNAPSHOT_DIR=~/.local/state/dendroflow/snapshots
